{
  "name": "dsh-desktop-toast",
  "version": "0.1.1",
  "description": "DeepSeek Harness 桌面通知：任务中断（等你审批/回答）与任务完成时弹出系统通知。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "icon": "./icon.svg",
  "files": [
    "index.js",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "PUBLISHING.md",
    "LICENSE",
    "icon.svg",
    "locale/*.json",
    "docs/toast.png"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "notification",
    "toast",
    "windows-toast",
    "desktop-notification"
  ],
  "license": "MIT",
  "author": "hhaosheng (https://github.com/hhaosheng)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hhaosheng/dsh-desktop-toast.git"
  },
  "homepage": "https://github.com/hhaosheng/dsh-desktop-toast#readme",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.5"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-session": ">=0.1.5-rc.1"
  },
  "scripts": {
    "test": "node --test test"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
